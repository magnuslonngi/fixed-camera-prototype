.inventory-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 24px;
}

.inventory-panel {
    min-width: 220px;
    padding: 12px 16px;
    border-radius: 6px;
    background-color: rgba(20, 20, 20, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.inventory-panel--hidden {
    display: none;
}

.inventory-panel--selecting {
    background-color: rgba(10, 10, 10, 0.9);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.95);
}

.inventory-panel__title {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0 0 6px 0;
    padding: 0;
}

.inventory-panel__list {
    flex-direction: column;
}

.inventory-item {
    color: rgb(255, 255, 255);
    font-size: 18px;
    margin: 2px 0;
    padding: 2px 8px;
    border-radius: 3px;
}

.inventory-item--selected {
    background-color: rgba(255, 255, 255, 0.95);
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
}

.inventory-panel__empty {
    color: rgba(255, 255, 255, 0.6);
    font-size: 16px;
    -unity-font-style: italic;
    margin: 2px 0;
    padding: 2px 8px;
}

.inventory-panel__feedback {
    display: none;
    color: rgb(255, 120, 100);
    font-size: 15px;
    margin: 6px 0 0 0;
    padding: 0 8px;
}

.inventory-panel__feedback--visible {
    display: flex;
}

.inventory-panel__hint {
    display: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    margin: 8px 0 0 0;
    padding: 0;
}

.inventory-panel--selecting > .inventory-panel__hint {
    display: flex;
}

.inventory-panel__description {
    display: none;
    max-width: 360px;
    white-space: normal;
    color: rgb(235, 225, 200);
    font-size: 15px;
    margin: 8px 0 0 0;
    padding: 6px 8px;
    border-top-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.inventory-panel__description--visible {
    display: flex;
}
