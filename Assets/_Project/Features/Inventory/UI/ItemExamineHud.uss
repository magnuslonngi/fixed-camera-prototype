.examine-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(12, 12, 14, 0.94);
}

.examine-overlay--visible {
    display: flex;
}

.examine-overlay__preview {
    width: 600px;
    height: 600px;
    -unity-background-scale-mode: scale-to-fit;
}

.examine-overlay__name {
    color: rgb(255, 255, 255);
    font-size: 36px;
    -unity-font-style: bold;
    margin: 8px 0 0 0;
}

.examine-overlay__description {
    max-width: 800px;
    white-space: normal;
    -unity-text-align: upper-center;
    color: rgb(235, 225, 200);
    font-size: 24px;
    margin: 12px 0 0 0;
}

.examine-overlay__hint {
    position: absolute;
    bottom: 32px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 20px;
}
