.reader-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(45, 45, 45, 0.97);
}

.reader-overlay--visible {
    display: flex;
}

.reader-page {
    max-width: 900px;
    padding: 32px 48px;
}

.reader-page__text {
    white-space: normal;
    -unity-text-align: middle-center;
    color: rgb(235, 228, 210);
    font-size: 30px;
}

.reader-overlay__hint {
    position: absolute;
    bottom: 32px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 18px;
}
