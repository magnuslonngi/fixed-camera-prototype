.menu-option {
    color: rgb(255, 255, 255);
    font-size: 30px;
    margin: 4px 0;
    padding: 10px 24px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.menu-option--selected {
    background-color: rgba(255, 255, 255, 0.95);
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
}
